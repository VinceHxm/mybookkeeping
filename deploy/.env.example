# 复制为 deploy/.env 后使用：cp .env.example .env
# 可与 backend/.env 保持一致。依赖全部外置，compose 不启 MySQL/Redis/MinIO。

SERVER_ADDR=:8080

MYSQL_DSN=user:password@tcp(127.0.0.1:3306)/mybookkeeping?charset=utf8mb4&parseTime=True&loc=Local

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mybookkeeping
MINIO_USE_SSL=false
# 浏览器访问附件的根地址。站点为 HTTPS 时此处也必须是 https://（反代到 MinIO），否则图片 Mixed Content 加载失败。
MINIO_PUBLIC_URL=http://127.0.0.1:9000

AMAP_KEY=
AMAP_SECURITY_CODE=

SESSION_TTL_DAYS=7
ALLOW_REGISTER=true
RESET_TOKEN_IN_RESPONSE=true
RESET_TOKEN_TTL_HOURS=2

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-flash
