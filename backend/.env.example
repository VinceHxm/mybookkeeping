# 复制为 .env 即可：  copy .env.example .env
# 启动时自动加载 backend/.env，无需设置系统环境变量。
# 自定义路径：设置环境变量 CONFIG_FILE=D:\path\to\my.env

SERVER_ADDR=:8080

MYSQL_DSN=user:password@tcp(127.0.0.1:3306)/mybookkeeping?charset=utf8mb4&parseTime=True&loc=Local

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mybookkeeping
# 后端连 MinIO 用；与浏览器访问无关。飞牛/内网 HTTP 保持 false 即可。
MINIO_USE_SSL=false
# 给浏览器看的附件根地址。生产站点若是 HTTPS，这里必须也是 https://（反代到 MinIO），
# 否则会 Mixed Content：浏览器把 http 升成 https 后 9010 无证书 → ERR_SSL_PROTOCOL_ERROR。
MINIO_PUBLIC_URL=http://127.0.0.1:9000

AMAP_KEY=
AMAP_SECURITY_CODE=

SESSION_TTL_DAYS=7

ALLOW_REGISTER=true
RESET_TOKEN_IN_RESPONSE=true
RESET_TOKEN_TTL_HOURS=2

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-flash
